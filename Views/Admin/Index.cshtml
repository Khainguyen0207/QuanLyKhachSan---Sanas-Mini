@{
    ViewBag.Title = "Dashboard - Quản trị hệ thống";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary text-center mb-4">
        📊 Thống kê doanh thu hệ thống
    </h2>

    <!-- 🔍 Bộ lọc -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <label>Từ ngày:</label>
            <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3">
            <label>Đến ngày:</label>
            <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-3">
            <label>Resort:</label>
            <select name="resortId" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var r in ViewBag.Resorts)
                {
                    <option value="@r.id" @(r.id == ViewBag.SelectedResortId ? "selected" : "")>
                        @r.name
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid align-items-end">
            <button type="submit" class="btn btn-primary mt-4">
                <i class="bi bi-funnel"></i> Lọc dữ liệu
            </button>
        </div>
    </form>

    <!-- 🧮 Thống kê tổng -->
    <div class="row text-center mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm p-3 border-0 bg-light">
                <h5 class="text-muted">💰 Doanh thu dự kiến (Confirmed + Completed)</h5>
                <h3 class="text-primary fw-bold">@string.Format("{0:N0} đ", ViewBag.EstimatedRevenue)</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm p-3 border-0 bg-light">
                <h5 class="text-muted">✅ Doanh thu thực tế (đã thanh toán)</h5>
                <h3 class="text-success fw-bold">@string.Format("{0:N0} đ", ViewBag.ActualRevenue)</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3 border-0 bg-light">
                <h5 class="text-muted">Tổng số đơn đặt</h5>
                <h3 class="text-primary fw-bold">@ViewBag.TotalBookings</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-3 border-0 bg-light">
                <h5 class="text-muted">Khách hàng đăng ký</h5>
                <h3 class="text-info fw-bold">@ViewBag.TotalCustomers</h3>
            </div>
        </div>
    </div>

    <!-- 📈 Biểu đồ doanh thu -->
    <div class="card shadow-sm p-4">
        <h5 class="fw-bold mb-3 text-center">Biểu đồ doanh thu theo ngày</h5>
        <canvas id="revenueChart" height="120"></canvas>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('revenueChart').getContext('2d');
    const revenueChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Dates)),
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Values)),
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: true, position: 'bottom' }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
