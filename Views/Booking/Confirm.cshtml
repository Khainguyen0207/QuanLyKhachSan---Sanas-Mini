@{
    ViewBag.Title = "Xác nhận đặt phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var room = ViewBag.Room as QuanLyKhachSan.Models.Room;
    var resort = ViewBag.Resort as QuanLyKhachSan.Models.Resort;
}

<div class="container-fluid">
    <section class="order-processing-section payment-wrapper" style="margin-top: 6rem;">
        <div class="progress-bar-container">
            <div class="progress-step active">
                <div class="circle">1</div>
                <span>Kiểm tra</span>
            </div>
            <div class="progress-step active">
                <div class="circle">2</div>
                <span>Thanh toán</span>
            </div>
            <div class="progress-step completed">
                <div class="circle"><i class="fas fa-check"></i></div>
                <span>Xác nhận</span>
            </div>
        </div>
        <div class="container align-items-lg-start">
            <section class="left">
                <form action="#" method="get" class="needs-validation" novalidate
                      data-bs-toggle="order-processing-form">
                    <div class="live-help mb-4" style=" border: 2px solid var(--primary-color);">
                        <h2>Hỗ trợ trực tuyến SANAS</h2>
                        <div class="secure-payment-info"
                             style="border-left-color: #28a745; background-color: #e6ffe6; color: #333;">
                            <i class="fa-solid fa-lock"></i> Hệ thống hỗ trợ của chúng tôi dựa trên thời gian đặt phòng và nhận được hỗ trợ ưu tiên.
                        </div>

                        <div class="help-option selected">
                            <div class="input-group align-items-start">
                                <input type="radio" name="help-option" id="helpOption1" value="standard"
                                       checked>
                                <label class="help-option-details m-0" for="helpOption1">
                                    <strong>Tiêu chuẩn</strong>
                                    <span><i class="fa-solid fa-clock"></i> Nhận phòng 24/7</span>
                                </label>
                            </div>
                            <span class="help-option-price free">MIỄN PHÍ</span>
                        </div>
                    </div>

                    <div class="secure-payment p-0">
                        <h2 class="fw-bold mb-0 ps-2 text-primary">
                            <span>
                                <img src="@Url.Content("~/Content/assets/icon-images/baoche.png")" alt="baoche"
                                     class="shield" style="max-width: 50px;">
                            </span> Thanh toán an toàn
                        </h2>
                        <div class="text-black-50 fw-bold ps-2 mb-1 fs-xs">
                            Tất cả thông tin thẻ được mã hóa, bảo mật và bảo vệ hoàn toàn.
                        </div>
                        <div class="payment-method-header">
                            <label class="credit py-2 fs-6 ms-3">
                                Tùy chọn đặt cọc phòng
                            </label>
                        </div>
                        <div class="padding-pay p-2">
                            <div class="padding-box">
                            </div>
                            <div class="text-black-50 fw-bold ps-2 mt-4 fs-xs">
                                Vui lòng chọn phương thức thanh toán
                                <span class="text-danger">*</span>
                            </div>
                            <div class="padding-pay2 p-2">
                                <select id="paymentMethodSelect"
                                        class="left-select-edigital-payment w-50 form-select" name="deposit-method">
                                    <option value="later" selected>Thanh toán sau</option>
                                </select>
                                <p class="text-black-50 fst-italic fs-xs">
                                    Bạn có thể chọn đặt cọc để giữ chỗ, hoặc tiếp tục mà không cần đặt cọc.
                                </p>
                            </div>
                        </div>
                    </div>
                </form>
            </section>

            <section class="right">
                <div class="room-info">
                    <div class="room-items">
                        @{
                            List<string> images = new List<string>();

                            if (!string.IsNullOrEmpty(room.images))
                            {
                                var clean = room.images.Replace("[", "").Replace("]", "").Replace("\"", "");
                                images = clean.Split(',').Select(x => x.Trim()).ToList();
                            }
                        }
                        <img src="@Url.Content("~/Content/Upload/Images/" + (room.thumbnail ?? "default.jpg"))" alt="">
                        <div>
                            <h3 class="py-1 name-room">@resort.name</h3>
                            <div class="stars py-1">
                                <i class="fa-solid fa-star"></i> <span class="fw-bold"></span>
                            </div>
                            <div class="location-views">
                                <div class="fw-bold text-black">
                                    <i class="fa-solid fa-location-dot py-1"></i>
                                    <span class="address">@resort.address</span>
                                </div>
                                <div class="fw-bold py-1">111 views</div>
                            </div>
                        </div>
                    </div>


                    <div class="room-bottom">
                        <h3 class="mb-3">Thông tin phòng</h3>

                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i> Sức chứa
                        </div>
                        <div class="room-details">
                            <div class="room-text-info">
                                <p class="fs-6">Người Lớn: <span class="fw-bold">@room.number_of_adults</span></p>
                                <p class="fs-6">Trẻ em: <span class="fw-bold">@room.number_of_children</span></p>
                            </div>
                        </div>

                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i> Tiện ích
                        </div>

                        @{
                            List<string> amenities = room.room_amenities.Split(',').ToList();
                            List<string> colors = new List<string> { "red", "green", "text-primary", "text-info" };
                            int i = 0;

                            <ul class="features">
                                @foreach (string amenitie in amenities)
                                {
                                    <li class="@colors[i]">@amenitie</li>

                                    if (i == colors.Count - 1)
                                    {
                                        i = 0;
                                    }
                                    else
                                    {
                                        i++;
                                    }
                                }
                            </ul>
                        }


                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i>
                            <span>Mô tả phòng</span>
                        </div>
                        <p style="font-size: 0.85em ">@room.description</p>
                    </div>
                </div>
                <div class="booking-box">
                    <div class="price-row">
                        <div></div>
                        <div class="bg-danger text-white text-center sale-box">
                            Giảm giá 10%
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giá phòng / 1 Đêm</div>
                        <div>
                            <span class="price">@string.Format("{0:N0} VNĐ", room.price)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giá phòng</div>
                        <div>
                            <span class="price">@string.Format("{0:N0} VNĐ", room.price * 0.9m * (decimal)ViewBag.Days)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giảm Giá</div>
                        <div>
                            <span class="discount">@string.Format("{0:N0} VNĐ", room.price * 0.1m * (decimal)ViewBag.Days)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Số Đêm</div>
                        <div>
                            <span class="number-of-days">@ViewBag.Days Đêm</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Ngày vào dự kiến</div>
                        <div>@ViewBag.Checkin.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="price-row">
                        <div>Ngày ra dự kiến</div>
                        <div>@ViewBag.Checkout.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="line"></div>
                    <div class="price-row total-price">
                        <div>Tổng cộng</div>
                        <div style="color: #28a745 !important">
                            <span class="total" style="color: #28a745 ">@string.Format("{0:N0}", (decimal)ViewBag.Days * room.price * 0.9m)</span>
                            <span>VNĐ</span>
                        </div>
                    </div>

                    <div style="font-size: 12px; color: #777;">Bao gồm: Phí dịch vụ và thuế</div>

                    <form method="post" action="@Url.Action("Success", "Booking")">
                        <input type="hidden" name="paymentMethod" value="later" />
                        <input type="hidden" name="roomId" value="@room.id" />
                        <input type="hidden" name="checkin" value="@ViewBag.Checkin" />
                        <input type="hidden" name="checkout" value="@ViewBag.Checkout" />
                        <input type="hidden" name="total" value="@ViewBag.Total" />
                        <input type="hidden" name="email" value="@ViewBag.Email" />
                        <input type="hidden" name="phone" value="@ViewBag.Phone" />

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="confirm-information">
                            <label class="form-check-label" for="confirm-information">Tôi xác nhận những thông tin trên và đã đọc <a href="#checkin-policy">Quy định nhận phòng</a></label>
                        </div>

                        <button type="submit" class="btn-pay fw-bold"
                                data-action="order-processing-form-submit">
                            Xác Nhận
                        </button>

                        <div class="not-charged">Bạn sẽ không bị tính phí nữa.</div>
                    </form>
                </div>

                <div class="booking-box" style="font-size: 0.85rem" id="checkin-policy">
                    <h3 style="margin-top:0;font-size:16px;font-weight:600;color:#222;">Quy định nhận phòng</h3>
                    <ul style="margin:0 0 8px 18px;padding:0;">
                        <li>Thời gian <strong>nhận phòng (Check-in)</strong>: sau <strong>14:00</strong> ngày nhận phòng.</li>
                        <li>Thời gian <strong>trả phòng (Check-out)</strong>: trước <strong>12:00 trưa</strong> ngày trả phòng.</li>
                        <li>Khách nhận phòng sớm hoặc trả phòng trễ sẽ được tính <strong>phụ thu</strong> tùy theo quy định của khách sạn.</li>
                        <li>Trường hợp khách đến muộn (sau 22:00), phòng vẫn được giữ và tính phí như bình thường.</li>
                    </ul>
                    <p style="margin:0;font-size:13px;color:#555;">
                        Ví dụ: Đặt từ ngày <strong>01 → 03</strong> sẽ tính <strong>2 đêm</strong> (đêm 01→02 và đêm 02→03).
                    </p>
                </div>
            </section>
        </div>
    </section>
</div>