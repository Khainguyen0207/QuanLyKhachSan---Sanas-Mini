@model IEnumerable<QuanLyKhachSan.Models.Room>

@{
    ViewBag.Title = "Phòng của " + ViewBag.Resort.name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center fw-bold mb-4 text-primary">
        🏨 Danh sách phòng tại @ViewBag.Resort.name
    </h2>
    <p class="text-center text-muted">@ViewBag.Resort.address</p>

    <!-- 🔍 Tìm kiếm và sắp xếp -->
    <form method="get" class="row g-2 mb-4">
        <input type="hidden" name="resortId" value="@ViewBag.Resort.id" />

        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control" placeholder="Tìm tên phòng hoặc mô tả..." />
        </div>

        <div class="col-md-3">
            <select name="sort" class="form-select">
                <option value="">-- Sắp xếp theo --</option>
                <option value="price_asc" @(ViewBag.Sort == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                <option value="price_desc" @(ViewBag.Sort == "price_desc" ? "selected" : "")>Giá giảm dần</option>
                <option value="name_asc" @(ViewBag.Sort == "name_asc" ? "selected" : "")>Tên A–Z</option>
                <option value="name_desc" @(ViewBag.Sort == "name_desc" ? "selected" : "")>Tên Z–A</option>
            </select>
        </div>

        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Lọc
            </button>
        </div>
    </form>

    <!-- 🏠 Danh sách phòng -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="text-center text-muted mt-4">Không có phòng nào phù hợp.</div>
        }
        else
        {
            foreach (var room in Model)
            {
                <div class="col-md-4 mb-4">
                    <a href="@Url.Action("Details", "Room", new { id = room.id })"
                       class="text-decoration-none text-dark">
                        <div class="card shadow-sm h-100 hover-card">
                            <img src="@Url.Content("~/Content/Images/" + room.thumbnail)"
                                 class="card-img-top" style="height:230px; object-fit:cover;" />
                            <div class="card-body">
                                <h5 class="fw-bold">@room.name</h5>
                                <p class="text-muted mb-1">@room.description</p>
                                <p><strong>Tiện nghi:</strong> @room.room_amenities</p>
                                <p class="fw-bold text-primary">@string.Format("{0:N0}đ / đêm", room.price)</p>
                            </div>
                        </div>
                    </a>
                </div>
            }

        }
    </div>

    <!-- 📄 Phân trang -->
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?resortId=@ViewBag.Resort.id&page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search&sort=@ViewBag.Sort">Prev</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?resortId=@ViewBag.Resort.id&page=@i&search=@ViewBag.Search&sort=@ViewBag.Sort">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?resortId=@ViewBag.Resort.id&page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search&sort=@ViewBag.Sort">Next</a>
            </li>
        </ul>
    </nav>
</div>
