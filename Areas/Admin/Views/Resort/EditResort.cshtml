@model QuanLyKhachSan.Models.Resort

@{
    ViewBag.Title = "Chỉnh sửa Resort";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";

    var selectedSuccess = (Model.option_success ?? "").Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
    var selectedError = (Model.option_error ?? "").Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary text-center mb-4">
        ✏️ Chỉnh sửa Resort
    </h2>

    @using (Html.BeginForm("EditResort", "Resort", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.id)

        <div class="card shadow-sm p-4">
            <div class="mb-3">
                <label class="form-label fw-semibold">Tên Resort:</label>
                @Html.TextBoxFor(m => m.name, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Địa chỉ:</label>
                @Html.TextBoxFor(m => m.address, new { @class = "form-control" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-success fw-bold">✅ Tùy chọn thành công</h5>
                    <div class="border rounded p-3 bg-light">
                        @foreach (var f in ViewBag.Features as List<string>)
                        {
                            bool isChecked = selectedSuccess.Contains(f);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="successOptions" value="@f" @(isChecked ? "checked" : "") />
                                <label class="form-check-label">@f</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="text-danger fw-bold">⚠️ Tùy chọn lỗi</h5>
                    <div class="border rounded p-3 bg-light">
                        @foreach (var e in ViewBag.Errors as List<string>)
                        {
                            bool isChecked = selectedError.Contains(e);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="errorOptions" value="@e" @(isChecked ? "checked" : "") />
                                <label class="form-check-label">@e</label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save"></i> Lưu thay đổi
                </button>
                <a href="@Url.Action("Index", "Resort", new { area = "Admin" })" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    }
</div>
