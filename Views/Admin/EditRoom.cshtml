@model QuanLyKhachSan.Models.Room

@{
    ViewBag.Title = "Chỉnh sửa phòng";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-warning mb-4 text-center">
        ✏️ Chỉnh sửa phòng: <span class="text-primary">@Model.name</span>
    </h2>

    <div class="card shadow-lg border-0 rounded-4 p-4">
        <form method="post" action="@Url.Action("EditRoom", "Admin")">
            @Html.HiddenFor(m => m.id)

            <!-- Tên phòng -->
            <div class="mb-3">
                <label class="form-label fw-bold">Tên phòng:</label>
                <input type="text" name="name" class="form-control" value="@Model.name" required />
            </div>

            <!-- Giá -->
            <div class="mb-3">
                <label class="form-label fw-bold">Giá (VNĐ / đêm):</label>
                <input type="number" name="price" class="form-control" value="@Model.price" min="0" required />
            </div>

            <!-- Số lượng -->
            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng phòng:</label>
                <input type="number" name="quantity" class="form-control" value="@Model.quantity" min="1" required />
            </div>

            <!-- Tiện nghi -->
            <div class="mb-3">
                <label class="form-label fw-bold">Tiện nghi phòng:</label>
                <textarea name="room_amenities" class="form-control" rows="3">@Model.room_amenities</textarea>
            </div>

            <!-- Ảnh -->
            <div class="mb-3">
                <label class="form-label fw-bold">Ảnh phòng (tùy chọn):</label>
                <input type="text" name="images" class="form-control" value="@Model.images"
                       placeholder="Nhập đường dẫn ảnh, ngăn cách bằng dấu phẩy nếu nhiều ảnh" />
                <small class="text-muted">VD: room1.jpg, room2.jpg</small>
            </div>

            <div class="text-end mt-4">
                <a href="@Url.Action("RoomList", "Admin", new { resortId = Model.resort_id })"
                   class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>

                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-save"></i> Cập nhật phòng
                </button>
            </div>
        </form>
    </div>
</div>
