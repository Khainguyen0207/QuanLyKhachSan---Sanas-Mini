@model QuanLyKhachSan.Models.Room
@using QuanLyKhachSan.Enums
@using QuanLyKhachSan.Models

@{
    ViewBag.Title = "Rooms";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";

    Dictionary<string, string> form = new Dictionary<string, string>();
    Room room = TempData["form"] as Room ?? new Room();

    if (Model == null)
    {
        form["name"] = "Store";
        form["title"] = "Create Room";
        form["method"] = "POST";
    }
    else
    {
        form["name"] = "Edit/" + Model.id;
        form["title"] = "Edit Room #" + Model.id;
        form["method"] = "POST";

        room = Model as Room;
    }
}

<style>
    textarea {
        resize: vertical !important;
    }
</style>

<div class="row">
    <h3 class="card-title">@form["title"]</h3>

    <div class="form-has-data" id="customer-generate">
        @using (Html.BeginForm(form["name"], "Room", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="row flex-row-reverse">
                <div class="col-md-3 col-12">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h3 class="mb-4">Action</h3>
                            <button type="submit" class="btn btn-primary btn-icon-text mb-3">
                                <i class="mdi mdi-file-check btn-icon-prepend"></i> Submit
                            </button>
                            <button type="reset" class="btn btn-danger btn-icon-text mb-3" data-bb-toggle="btn-with-href"
                                    data-url="@Url.Action("Index", "Resort", new { area = "Admin" })">
                                <i class="mdi mdi-file-cancel btn-icon-prepend"></i> Cancel
                            </button>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h3 class="mb-4">Status</h3>
                            <select class="form-select" aria-label="Default select example" id="status" name="status" style=" border: 1px solid var(--text-table-color); border-radius: 2px;">
                                @foreach (BaseStatusEnum status in Enum.GetValues(typeof(BaseStatusEnum)))
                                {
                                    <option value="@status" @(room.status == status.ToString() ? "selected" : null)> @(EnumExtention.GetDescription(status)) </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="col-md-9 col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="form-section mb-4">
                                <div class="row">
                                    <!-- Customer ID -->
                                    <div class="mb-3 col-md-6">
                                        <label for="resort_id" class="form-label">Customer Manager</label>
                                        <select class="form-select" id="resort_id" name="resort_id" style=" border: 1px solid var(--text-table-color); border-radius: 2px;">
                                            <option value="" selected>Select Resort</option>

                                            @foreach (QuanLyKhachSan.Models.Resort resort in ViewBag.Resorts)
                                            {
                                                <option value="@resort.id">@resort.name</option>
                                            }
                                        </select>
                                    </div>

                                    <!-- Tên phòng -->
                                    <div class="mb-3 col-md-6">
                                        <label class="form-label">Tên phòng</label>
                                        <input type="text" name="name" class="form-control" placeholder="Nhập tên phòng..." value="@(room.name)" required />
                                    </div>

                                    <!-- Giá -->
                                    <div class="mb-3 col-md-6">
                                        <label class="form-label">Giá (VNĐ / đêm)</label>
                                        <input type="number" name="price" class="form-control" min="0" value="@String.Format("{0:00}", room.price)" placeholder="VD: 1500000" required />
                                    </div>

                                    <!-- Số lượng -->
                                    <div class="mb-3 col-md-6">
                                        <label class="form-label">Số lượng phòng</label>
                                        <input type="number" name="quantity" class="form-control" min="1" value="@(room.quantity ?? 0)" required />
                                    </div>

                                    <!-- Số lượng người lớn -->
                                    <div class="mb-3 col-md-6">
                                        <label for="number_of_adults" class="form-label">Số lượng người lớn</label>
                                        <input type="number" name="number_of_adults" id="number_of_adults" class="form-control" min="1" value="@(room.number_of_adults ?? 0)" required />
                                    </div>


                                    <!-- Số lượng trẻ em-->
                                    <div class="mb-3 col-md-6">
                                        <label for="number_of_children" class="form-label">Số lượng trẻ em</label>
                                        <input type="number" id="number_of_children" name="number_of_children" class="form-control" min="1" value="@(room.number_of_children ?? 0)" required />
                                    </div>


                                    <!-- Description -->
                                    <div class="mb-3 col-12">
                                        <label for="description" class="form-label">Description</label>
                                        <textarea id="description" name="description" class="form-control">@room.description</textarea>
                                    </div>

                                    <!-- Tiện nghi -->
                                    <div class="mb-3">
                                        <label class="form-label">Tiện nghi phòng</label>
                                        <textarea name="room_amenities" class="form-control" rows="3"
                                                  placeholder="VD: Máy lạnh, Tivi, Wifi, Bàn làm việc">@room.room_amenities</textarea>
                                    </div>

                                    <!-- Thumbnail -->
                                    <div class="mb-3 col-12">
                                        <label for="thumbnail" class="form-label">Thumbnail</label>
                                        <input type="file" id="thumbnail" name="thumbnail" class="form-control" accept="image/*">
                                    </div>

                                    <!-- Images -->
                                    <div class="mb-3 col-12">
                                        <label for="images" class="form-label">Images</label>
                                        <input type="file" id="images" name="images" class="form-control" accept="image/*" multiple>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>