@model IEnumerable<QuanLyKhachSan.Models.Booking>

@{
    ViewBag.Title = "Thông tin cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = ViewBag.User as QuanLyKhachSan.Models.Customer;
}

<div class="container-fluid homepage-section">
    <section class="user-profile-section" style="margin-top: 76px;">
        <div class="row main-content ">
            <div class="sidebar col-lg-2 d-flex flex-column text-center ps-0">
                <div class="pe-4 mt-2">
                    <a href="#" class="sidebar-link text-decoration-none mb-3 active"
                       data-page="User_Profile">Thông tin</a>
                    <a href="my-booking.html" class="sidebar-link text-decoration-none mb-3 ">Đơn đặt phòng của tôi</a>
                </div>
            </div>
            
            <div class="user-info col-lg-10 p-5 pt-3">
                <div class="form-container border h-100 p-3 d-flex flex-column rounded-4">
                    <div class="user-profile-form d-flex flex-column flex-md-row align-items-center justify-content-between p-3 rounded-5">
                        <div class="user-avt flex-shrink-0">
                            @{string avatar = string.IsNullOrEmpty(user.avatar) ? Url.Content("~/Content/assets/images/default-avatar.png") : Url.Content("~/Content/Upload/Avatar/" + user.avatar);}
                            <img src="@avatar" alt="avatar"
                                    class="rounded-circle img-fluid"
                                    style="width: 80px; height: 80px; object-fit: cover;">
                        </div>
                        <div class="user-name text-center text-md-start">
                            <h4 class="mb-2 username">@user.name</h4>
                            <p class="booking-time mt-2">
                                <strong>Đặt phòng: @Model.ToList().Count</strong>
                            </p>
                        </div>
                        <div class="editor text-md-end text-center ">
                            <a href="">Chỉnh sửa</a>
                        </div>
                    </div>
                    <div class="personal-detail p-3 rounded-4 border ">
                        <h6 class="mb-3">Thông tin cá nhân</h6>

                        <div class="personal-contact">
                            <p class="mb-2">
                                <i class="fa-regular fa-envelope" style="color: #22a2e3;"></i>
                                <span class="email">@user.email</span>
                            </p>
                            <p class="mb-2">
                                <i class="fa-solid fa-phone" style="color: #ff0000;"></i> @(user.phone ?? "Chưa Cập Nhật")
                            </p>
                            <p class="mb-2">
                                <i class="fas fa-map-pin gradient-icon-locate"></i> @(user.address ?? "Chưa Cập Nhật")
                            </p>
                            <p class="mb-2"><i></i>📅 Ngày đăng ký: @user.created_at</p>
                        </div>
                    </div>

                    <div class="booking-history">
                        <div class="d-flex justify-content-between p-3">
                            <div class="title">
                                <h5>Booking history</h5>
                            </div>
                            <div>
                                <a href="" class="text-decoration-none">Detail</a>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="history-table table">
                                <thead>
                                    <tr>
                                        <th class="p-3">Nơi Nghĩ Dưỡng</th>
                                        <th class="p-3">Phòng</th>
                                        <th class="p-3">Ngày Nhận Phòng</th>
                                        <th class="p-3">Ngày Trả</th>
                                        <th class="p-3">Trạng thái</th>
                                        <th class="p-3">Trạng thái Thanh Toán</th>
                                        <th class="p-3">Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.ToList().Count > 0)
                                        {
                                            foreach (var b in Model)
                                            {
                                                var resort = b.Resort;
                                                var room = b.Room;

                                                <tr>
                                                    <td>@(resort?.name ?? "—")</td>
                                                    <td>@(room?.name ?? "—")</td>
                                                    <td>@string.Format("{0:dd/MM/yyyy}", b.check_in)</td>
                                                    <td>@string.Format("{0:dd/MM/yyyy}", b.check_out)</td>

                                                    <td>
                                                        @if (b.status == "confirmed")
                                                        {
                                                            <span class="badge bg-success">Đã xác nhận</span>
                                                        }
                                                        else if (b.status == "pending")
                                                        {
                                                            <span class="badge bg-warning text-dark">Đang xử lý</span>
                                                        }
                                                        else if (b.status == "cancelled")
                                                        {
                                                            <span class="badge bg-danger">Đã hủy</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (b.payment_status == "paid")
                                                        {
                                                            <span class="badge bg-primary">Đã thanh toán</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Chưa thanh toán</span>
                                                        }
                                                    </td>
                                                    <td>@string.Format("{0:N0}đ", b.total_price)</td>
                                                </tr>
                                            }

                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center">Chưa có hoạt động nào</td>
                                            </tr>
                                        }

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="border"></div>

                    <div class="logout-btn text-center w-100 mb-5">
                        <a href="@Url.Action("Logout", "Account")" class="btn btn-primary w-50 fw-bold fs-5 rounded-5 p-2"
                                style="background-color: #00b2ff;""> Đăng xuất</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>