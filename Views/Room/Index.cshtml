@model IEnumerable<QuanLyKhachSan.Models.RoomViewModel>

@{
    ViewBag.Title = "Trang chủ - Danh sách Resort";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container-fluid">
    <section class="rooms-section mb-5" style="margin-top: 6rem;">
        <div class="homepage-section">
            <form class="booking-form" method="get" action="/Room/ListByResort">
                <div class="form-group">
                    <i class="fa fa-map-marker-alt"></i>
                    <input type="text" class="form-control" name="search" placeholder="Địa điểm...">
                </div>

                <div class="two-columns">
                    <div class="form-group">
                        <i class="fa fa-calendar-alt"></i>
                        <div class="label-inside">Nhận phòng:</div>
                        <input type="date" class="form-control" name="checkin_date" placeholder="Thời gian nhận phòng" @ViewBag.CheckIn>
                    </div>

                    <div class="form-group">
                        <i class="fa fa-calendar-alt"></i>
                        <div class="label-inside">Trả phòng:</div>
                        <input type="date" class="form-control" name="checkout_date" placeholder="Thời gian trả phòng" value="@ViewBag.CheckOut">
                    </div>

                    @*<script>
                        const date = new Date();
                        const inputCheckin = document.querySelector('input[name="checkin_date"]');
                        const inputCheckout = document.querySelector('input[name="checkout_date"]');

                        const now = new Date(date);
                        now.setDate(now.getDate() + 1);
                        const formatted = now.toISOString().split('T')[0];

                        inputCheckin.setAttribute("min", formatted);
                        inputCheckin.value = formatted

                        getDateCheckout();

                        inputCheckin.addEventListener("change", function () {
                            getDateCheckout()
                        })

                        function getDateCheckout() {
                            const dateMin = new Date(inputCheckin.value).toISOString().split('T')[0];

                            inputCheckout.setAttribute("min", dateMin)
                            inputCheckout.value = dateMin
                        }
                    </script>*@
                </div>

                <div class="guest-selector">
                    <div class="selector-toggle" onclick="toggleGuestBox()">
                        <i class="fa fa-user" style="font-size: 20px; color: #1da1f2;"></i>
                        <span id="guestSummary">2 Người lớn, 0 Trẻ em, 1 Phòng</span>
                        <i class="fa fa-chevron-down arrow"></i>
                    </div>

                    <div class="guest-box" id="guestBox" style="display: none;">
                        <div class="row">
                            <span>
                                <i class="fa fa-user" style="font-size: 20px; color: #1da1f2;"></i> Người
                                lớn
                            </span>
                            <div class="controls">
                                <button type="button" onclick="changeValue('adults', -1)">−</button>
                                <span id="adults">2</span>
                                <button type="button" onclick="changeValue('adults', 1)">+</button>
                            </div>
                        </div>

                        <div class="row">
                            <span><i class="fa fa-child" style="font-size: 20px; color: #1da1f2;"></i> Trẻ em</span>
                            <div class="controls">
                                <button type="button" onclick="changeValue('children', -1)">−</button>
                                <span id="children">0</span>
                                <button type="button" onclick="changeValue('children', 1)">+</button>
                            </div>
                        </div>
                        <div class="row">
                            <span><i class="fa fa-bed" style="font-size: 20px; color: #1da1f2;"></i> Phòng</span>
                            <div class="controls">
                                <button type="button" onclick="changeValue('rooms', -1)">−</button>
                                <span id="rooms">1</span>
                                <button type="button" onclick="changeValue('rooms', 1)">+</button>
                            </div>
                        </div>

                        <div class="done-wrapper">
                            <div class="done" onclick="toggleGuestBox()">Xong</div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="search-btn"><i class="fa fa-search"></i> Tìm kiếm</button>
            </form>
        </div>
        <div class="main-display container-fluid row mt-4">
            <div class="filter col-lg-3 col-12">
                <div class="title">
                    <strong>
                        <h4>Lọc theo:</h4>
                    </strong>
                </div>
                <section class="filter-section">
                    <form action="@Url.Action("ListByResort", "Room")" method="get">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-1 row-cols-sm-2 row-gap-2">
                            <div class="col">
                                <div class="card card-custom h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center toggle-filter"
                                         data-target="price-filter-body" style="cursor: pointer;">
                                        <strong class="mb-0">
                                            Giá mỗi đêm
                                        </strong>
                                        <i class="bi bi-chevron-down toggle-icon"></i>
                                    </div>
                                    <div class="p-3">
                                        <select class="form-select" name="sort">
                                            <option value="price_asc">Giá: Thấp đến cao</option>
                                            <option value="price_desc">Giá: Cao đến thấp</option>
                                        </select>
                                    </div>
                                    <div class="card-body filter-body" id="price-filter-body">
                                        <div class="form-check mb-2">
                                            <input type="radio" value="0-600000" name="priceRange" class="form-check-input price-filter" id="price2" />
                                            <label class="form-check-label" for="price2">
                                                0 - 600,000 VND
                                            </label>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input type="radio" value="600000-1000000" name="priceRange" class="form-check-input price-filter" id="price4"/>
                                            <label class="form-check-label" for="price4">
                                                600,000 - 1,000,000 VND
                                            </label>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input price-filter" type="radio"
                                                   name="priceRange" value="1000000" id="price5" >
                                            <label class="form-check-label" for="price5">
                                                Above 1,000,000 VND
                                            </label>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary my-2 w-100">Tìm kiếm</button>
                    </form>
                </section>
            </div>

            <div class="col-lg-9 rooms-wrapper">
                <div class="pro-place mb-4">
                    <div class="title"></div>
                    <div>
                        
                    </div>
                </div>
                <div class="row mt-4 g-3 mb-5" id="rooms">
                    @{
                        if (Model.ToList().Count > 0)
                        {
                            foreach (var room in Model)
                            {
                                <div class="col-lg-4 col-md-6 g-3">
                                    <div class="card rounded-4">
                                        <div class="p-3">
                                            @{
                                                string image = "default.jpg";

                                                if (!string.IsNullOrEmpty(room.Room.images))
                                                {
                                                    var clean = room.Room.images.Replace("[", "").Replace("]", "").Replace("\"", "");
                                                    image = clean.Split(',').Select(x => x.Trim()).FirstOrDefault() ?? "default.jpg";
                                                }
                                            }
                                            <img src="@Url.Content("~/Content/Upload/Images/" + room.Room.thumbnail)"
                                                    class="w-100 rounded-3 detail-img" alt="thumbnail">
                                        </div>
                                        <div class="card-body p-3 pt-0">
                                            <h6 class="card-title fw-bold">@room.Room.name</h6>
                                            <div class="p-3 pt-0 pb-0">
                                                <p class="mb-1 text-info fw-bold text-decoration-underline">
                                                    <i class="fa-solid fa-location-dot"></i>
                                                    @room.address
                                                </p>
                                                <ul class="list-unstyled text-success list-option-benefit">
                                                    <li class="button-has-icon">
                                                        <span>
                                                            <img src="@Url.Content("~/Content/assets/icon-images/tick-success.png")"
                                                                    alt="tick-success">
                                                        </span>
                                                        <span class="fw-bold">Miễn phí hủy</span>
                                                    </li>
                                                    <li class="button-has-icon">
                                                        <span>
                                                            <img src="@Url.Content("~/Content/assets/icon-images/tick-success.png")"
                                                                    alt="tick-success">
                                                        </span>
                                                        <span class="fw-bold">Không cọc trước</span>
                                                    </li>
                                                </ul>
                                                <p class="fw-bold" style="color: #f47c0e;">Từ: @string.Format("{0:N0}VNĐ", room.Room.price) </p>
                                            </div>
                                            <div class="text-end">
                                                <a href="@Url.Action("Details", "Room", new { id = room.Room.id })" class="see-more btn btn-primary rounded-4">Xem chi tiết</a>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            }

                            <div class="mt-5 mb-5">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        @{
                                            int total = ViewBag.TotalPages;
                                            int current = ViewBag.CurrentPage;
                                            int next = current < total ? current + 1 : total;
                                            int prev = current > 1 ? current - 1 : 1;
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", "Room", new { page = prev })">Prev</a>
                                        </li>

                                        @for (int i = 1; i <= total; i++)
                                        {
                                            <li class="page-item @(i == current ? "active" : null)">
                                                <a class="page-link" href="/Room/Index?page=@i">@i</a>
                                            </li>
                                        }

                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", "Room", new { page = next })">Next</a>
                                        </li>

                                    </ul>
                                </nav>
                            </div>
                        }
                        else
                        {
                            <h5 class="text-center"> Không có phòng phù hợp </h5>
                        }
                    }
                </div>

               
            </div>
    </section>
</div>