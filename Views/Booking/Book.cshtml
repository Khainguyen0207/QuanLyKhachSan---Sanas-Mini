@using System.Collections.Generic

@{

    ViewBag.Title = "Đặt phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var room = ViewBag.Room as QuanLyKhachSan.Models.Room;
    var resort = ViewBag.Resort as QuanLyKhachSan.Models.Resort;
}

<div class="container-fluid">
    <section class="order-payment-section payment-wrapper" style="margin-top: 6rem;">
        <div class="progress-bar-container">
            <div class="progress-step active">
                <div class="circle">1</div>
                <span>Kiểm tra</span>
            </div>
            <div class="progress-step">
                <div class="circle">2</div>
                <span>Thanh toán</span>
            </div>
            <div class="progress-step completed">
                <div class="circle"><i class="fas fa-check"></i></div>
                <span>Xác nhận</span>
            </div>
        </div>
        <div class="container align-items-lg-start">
            <section class="left">
                <div class="container_items">
                    <h2>Thông tin người đặt phòng</h2>
                    <div class="required-hint text-danger fst-italic">* Bắt buộc điền đầy đủ thông tin</div>
                    <form action="@Url.Action("Confirm", "Booking")" method="post" class="needs-validation" novalidate
                          data-bs-toggle="order-information-form">
                        <input type="hidden" name="roomId" value="@room.id" />
                        <div class="form-group">
                            <label for="lastName">Họ Tên*</label>
                            <input type="text" class="form-control" name="name"
                                   placeholder="Nhập họ tên của bạn" required>
                            <p class="text-danger ps-2 validation-message" style="font-size: 14px;"></p>
                        </div>
                        <div class="form-group">
                            <label for="email">Email*</label>
                            <input type="email" class="form-control" name="email" placeholder="Nhập email của bạn"
                                   required>
                            <div class="required-hint fst-italic">Chúng tôi sẽ gửi email xác nhận để giúp bạn quản lý đặt phòng. Nếu bạn không hoàn thành, đặt phòng của bạn sẽ hết hạn.</div>
                            <p class="text-danger ps-2 validation-message" style="font-size: 14px;"></p>
                        </div>
                        <div class="form-group">
                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Ngày nhận phòng</label>
                                    <input type="date" name="checkin" class="form-control" required />
                                    <p class="text-danger ps-2 validation-message" style="font-size: 14px;"></p>

                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Ngày trả phòng</label>

                                    <input type="date" name="checkout" class="form-control" required />
                                    <p class="text-danger ps-2 validation-message" style="font-size: 14px;"></p>
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            <label for="phoneNumber">Số điện thoại (tùy chọn)</label>
                            <input type="number" class="form-control" name="phoneNumber"
                                   placeholder="Nhập số điện thoại của bạn" required>
                            <p class="text-danger ps-2 validation-message" style="font-size: 14px;"></p>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }
                    </form>
                </div>

                <div class="container_items">
                    <h3>Yêu cầu đặc biệt</h3>
                    <div class="form-section-title" style="margin-top: 20px;">Bạn có yêu cầu thêm gì không? Hãy cho chúng tôi biết</div>
                    <textarea placeholder="Nhập yêu cầu của bạn tại đây..."></textarea>
                </div>
            </section>

            <section class="right">
                <div class="room-info">
                    <div class="room-items">
                        @{
                            List<string> images = new List<string>();

                            if (!string.IsNullOrEmpty(room.images))
                            {
                                var clean = room.images.Replace("[", "").Replace("]", "").Replace("\"", "");
                                images = clean.Split(',').Select(x => x.Trim()).ToList();
                            }
                        }
                        <img src="@Url.Content("~/Content/assets/images/room/" + images.FirstOrDefault() ?? "default.jpg")" alt="">
                        <div>
                            <h3 class="py-1 name-room">@resort.name</h3>
                            <div class="stars py-1">
                                <i class="fa-solid fa-star"></i> <span class="fw-bold"></span>
                            </div>
                            <div class="location-views">
                                <div class="fw-bold text-black">
                                    <i class="fa-solid fa-location-dot py-1"></i>
                                    <span class="address">@resort.address</span>
                                </div>
                                <div class="fw-bold py-1">111 views</div>
                            </div>
                        </div>
                    </div>

                    <div class="room-bottom">
                        <h3 class="mb-3">Thông tin phòng</h3>

                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i> Sức chứa
                        </div>
                        <div class="room-details">
                            <div class="room-text-info">
                                <p class="fs-6">Người Lớn: <span class="fw-bold">@room.number_of_adults</span></p>
                                <p class="fs-6">Trẻ em: <span class="fw-bold">@room.number_of_children</span></p>
                            </div>
                        </div>

                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i> Tiện ích
                        </div>

                        @{
                            List<string> amenities = room.room_amenities.Split(',').ToList();
                            List<string> colors = new List<string> { "red", "green", "text-primary", "text-info" };
                            int i = 0;

                            <ul class="features">
                                @foreach (string amenitie in amenities)
                                {
                                    <li class="@colors[i]">@amenitie</li>

                                    if (i == colors.Count - 1)
                                    {
                                        i = 0;
                                    }
                                    else
                                    {
                                        i++;
                                    }
                                }
                            </ul>
                        }


                        <div class="wifi-tag mb-0">
                            <i class="fa-solid fa-info-circle"></i>
                            <span>Mô tả phòng</span>
                        </div>
                        <p style="font-size: 0.85em ">@room.description</p>
                    </div>
                </div>
                <div class="booking-box">
                    <div class="price-row">
                        <div></div>
                        <div class="bg-danger text-white text-center sale-box">
                            Giảm giá 10%
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giá Gốc</div>
                        <div class="strikethrough">
                            <span class="original-price">@string.Format("{0:N0} VNĐ / Day", room.price)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giá / 1 Ngày</div>
                        <div>
                            <span class="price">@string.Format("{0:N0} VNĐ", room.price * 0.9m)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Giảm Giá</div>
                        <div>
                            <span class="discount">@string.Format("{0:N0} VNĐ", room.price * 0.1m)</span>
                        </div>
                    </div>
                    <div class="price-row">
                        <div>Số Ngày</div>
                        <div>
                            <span class="number-of-days">1</span>
                            <span>Ngày</span>
                        </div>
                    </div>
                    <div class="line"></div>
                    <div class="price-row total-price">
                        <div>Tổng cộng</div>
                        <div style="color: #28a745 !important">
                            <span class="total" style="color: #28a745 ">@string.Format("{0:N0}", room.price * 0.9m)</span>
                            <span>VNĐ</span>
                        </div>
                    </div>
                    <div style="font-size: 12px; color: #777;">Bao gồm: Phí dịch vụ và thuế</div>
                    @*<div class="footer-note">Our last @resort.Rooms rooms at this price</div>*@
                    <button type="button" class="btn-pay fw-bold"
                            data-action="order-information-form-submit">
                        Tiếp tục
                    </button>
                    <div class="not-charged">Bạn sẽ không bị tính phí nữa.</div>
                </div>

                <script>
                    const date = new Date();
                    const inputCheckin = document.querySelector('input[name="checkin"]');
                    const days = document.querySelector('span.number-of-days');
                    const inputCheckout = document.querySelector('input[name="checkout"]');

                    const now = date.toISOString().split('T')[0];
                    inputCheckin.setAttribute("min", now);
                    inputCheckin.value = now

                    getDateCheckout();

                    inputCheckin.addEventListener("change", function () {
                        getDateCheckout()
                    })

                    inputCheckout.addEventListener("change", function () {
                        const checkin = new Date(inputCheckin.value);
                        const checkout = new Date(inputCheckout.value);
                        let daysDiff = (checkout - checkin) / (1000 * 60 * 60 * 24);
                        daysDiff = (daysDiff == 0 ? 1 : daysDiff);

                        const priceOfDay = Math.round(@room.price);

                        days.textContent = Math.round(daysDiff);

                        const totalDom = document.querySelector(".total-price .total")
                        let total = (daysDiff == 0 ? 1 : daysDiff ) * priceOfDay * 0.9;
                        totalDom.textContent = total.toLocaleString();
                    })

                    function getDateCheckout() {
                        const dateMin = new Date(inputCheckin.value).toISOString().split('T')[0];

                        inputCheckout.setAttribute("min", dateMin)
                        inputCheckout.value = dateMin
                    }
                </script>
            </section>
        </div>
    </section>
</div>
