@model IEnumerable<QuanLyKhachSan.Models.ResortViewModel>

@{
    ViewBag.Title = "Danh sách Resort";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Resorts</h4>
                    <div class="action float-right">
                        <button type="reset" class="btn btn-inverse-primary btn-icon-text me-3"
                                data-bb-toggle="btn-with-href"
                                data-url="@Url.Action("CreateResort", "Admin")">
                            <i class="mdi mdi-plus"></i> Thêm
                        </button>
                    </div>

                    <div class="table-responsive shadow-sm rounded-4">
                        <table class="table" id="customer-table">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="form-check form-check-muted m-0">
                                            <label class="form-check-label">
                                                <input type="checkbox" class="form-check-input">
                                            </label>
                                        </div>
                                    </th>
                                    <th>ID</th>
                                    <th>Tên Resort</th>
                                    <th>Địa chỉ</th>
                                    <th>Giá thấp nhất</th>
                                    <th>Giá cao nhất</th>
                                    <th>Tùy chọn thành công</th>
                                    <th>Tùy chọn lỗi</th>
                                    <th>Ngày tạo</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                            
                            @if (!Model.Any())
                            {
                                
                            }
                            else
                            {
                                int i = 1;
                                foreach (var r in Model)
                                {
                            <tr>
                                <td>
                                    <div class="form-check form-check-muted m-0">
                                        <label class="form-check-label">
                                            <input type="checkbox" class="form-check-input">
                                        </label>
                                    </div>
                                </td>
                                <td class="text-center fw-bold">@i</td>
                                <td class="fw-semibold">
                                    <a href="@Url.Action("RoomList", "Admin", new { resortId = r.Id })"
                                       class="text-decoration-none text-primary fw-bold">
                                        @r.Name
                                    </a>
                                </td>
                                <td>@r.Address</td>
                                <td class="text-success fw-bold text-end">
                                    @String.Format("{0:N0}đ", r.MinPrice)
                                </td>
                                <td class="text-primary fw-bold text-end">
                                    @String.Format("{0:N0}đ", r.MaxPrice)
                                </td>
                                <td>@r.OptionSuccess</td>
                                <td>@r.OptionError</td>
                                <td class="text-center">
                                    @(r.CreatedAt.HasValue ? r.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "")
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("EditResort", "Admin", new { id = r.Id })" type="button"
                                       class="btn-sm btn-inverse-primary btn-icon">
                                        <i class="mdi mdi-pencil-box-outline"></i>
                                    </a>
                                    <a href="@Url.Action("DeleteResort", "Admin", new { id = r.Id })" type="button" class="btn-sm btn-inverse-danger btn-icon" data-bs-action="modal-confirm-action" data-bs-toggle="modal" data-bs-target="#modal-confirm-delete">
                                        <i class="mdi mdi-delete"></i>
                                    </a>
                                </td>
                            </tr>
                                    i++;
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>