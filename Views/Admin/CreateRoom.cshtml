@model QuanLyKhachSan.Models.Room

@{
    ViewBag.Title = "Thêm phòng mới";
    Layout = "~/Views/Shared/_AdminLayoutPage.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-success mb-4 text-center">➕ Thêm phòng mới</h2>

    <div class="card shadow-lg border-0 rounded-4 p-4">
        <form method="post" action="@Url.Action("CreateRoom", "Admin", new { resortId = ViewBag.ResortId })">
            <!-- Tên phòng -->
            <div class="mb-3">
                <label class="form-label fw-bold">Tên phòng:</label>
                <input type="text" name="name" class="form-control" placeholder="Nhập tên phòng..." required />
            </div>

            <!-- Giá -->
            <div class="mb-3">
                <label class="form-label fw-bold">Giá (VNĐ / đêm):</label>
                <input type="number" name="price" class="form-control" min="0" placeholder="VD: 1500000" required />
            </div>

            <!-- Số lượng -->
            <div class="mb-3">
                <label class="form-label fw-bold">Số lượng phòng:</label>
                <input type="number" name="quantity" class="form-control" min="1" value="1" required />
            </div>

            <!-- Tiện nghi -->
            <div class="mb-3">
                <label class="form-label fw-bold">Tiện nghi phòng:</label>
                <textarea name="room_amenities" class="form-control" rows="3"
                          placeholder="VD: Máy lạnh, Tivi, Wifi, Bàn làm việc"></textarea>
            </div>

            <!-- Ảnh phòng -->
            <div class="mb-3">
                <label class="form-label fw-bold">Ảnh phòng (tùy chọn):</label>
                <input type="text" name="images" class="form-control"
                       placeholder="Nhập đường dẫn ảnh, ngăn cách bằng dấu phẩy nếu nhiều ảnh" />
                <small class="text-muted">VD: room1.jpg, room2.jpg, room3.jpg</small>
            </div>

            <div class="text-end mt-4">
                <a href="@Url.Action("RoomList", "Admin", new { resortId = ViewBag.ResortId })"
                   class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle"></i> Lưu phòng
                </button>
            </div>
        </form>
    </div>
</div>
